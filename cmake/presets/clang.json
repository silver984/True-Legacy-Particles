{
  "version": 9,
  "include": [
    "base.json"
  ],
  "configurePresets": [
    {
      "name": "clang",
      "displayName": "Clang Configuration",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "clang",
      "configurePreset": "clang"
    }
  ]
}